<?xml version="1.0" encoding="utf-8"?>
<!--
  A deep navy-to-black diagonal, full-bleed. Near-black alone left the tile with
  no edge on a dark wallpaper; the lighter top-left corner gives the disc a
  surface. Gradients in a VectorDrawable are supported from API 24, our minSdk.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#1B2733"
                android:endColor="#0D1116" />
        </aapt:attr>
    </path>
</vector>
