        android:pathData="M6,8 V6 A1,1 0 0 1 7,5 H10 A1,1 0 0 1 11,6 V8 Z M13,8 V6 A1,1 0 0 1 14,5 H17 A1,1 0 0 1 18,6 V8 Z" />
    <!-- body: outer clockwise, inner counter-clockwise, so the middle is a hole -->
