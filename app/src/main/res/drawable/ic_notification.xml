        android:pathData="M7,8 H17 A3,3 0 0 1 20,11 V18 A3,3 0 0 1 17,21 H7 A3,3 0 0 1 4,18 V11 A3,3 0 0 1 7,8 Z M6,10 V19 H18 V10 Z" />
