<?xml version="1.0" encoding="utf-8"?>
<!--
  A traction battery - two terminal posts, the car-battery cue - holding four
  cell groups. Three are teal and full; one is red and sits lower: a weak cell
  group SAGS, and finding it is what this app is for.

  This replaced a thin-stroked heartbeat trace that vanished at 36-48 dp and on
  dark wallpapers. Solid blocks and a 5.5 dp outline survive both.

  Drawn on the 108 dp adaptive-icon canvas. The safe zone is a circle of 33 dp
  around (54,54): the post corners reach 30.1 and the body's rounded corners
  about 30 including the stroke.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- terminal posts: the car-battery cue a single-nub phone battery lacks -->
    <path android:fillColor="#EDEFF2" android:pathData="M33,41 v-6 a2.5,2.5 0 0 1 2.5,-2.5 h9 a2.5,2.5 0 0 1 2.5,2.5 v6 z M61,41 v-6 a2.5,2.5 0 0 1 2.5,-2.5 h9 a2.5,2.5 0 0 1 2.5,2.5 v6 z" />

    <!-- body -->
    <path
        android:pathData="M35,41 h38 a8,8 0 0 1 8,8 v16 a8,8 0 0 1 -8,8 h-38 a8,8 0 0 1 -8,-8 v-16 a8,8 0 0 1 8,-8 z"
        android:strokeColor="#EDEFF2"
        android:strokeWidth="5.5"
        android:strokeLineJoin="round" />

    <path android:fillColor="#35D0BA" android:pathData="M35,47 h5 a2,2 0 0 1 2,2 v16 a2,2 0 0 1 -2,2 h-5 a2,2 0 0 1 -2,-2 v-16 a2,2 0 0 1 2,-2 z" />
    <path android:fillColor="#35D0BA" android:pathData="M47,47 h5 a2,2 0 0 1 2,2 v16 a2,2 0 0 1 -2,2 h-5 a2,2 0 0 1 -2,-2 v-16 a2,2 0 0 1 2,-2 z" />
    <!-- the weak cell: lower, and red -->
    <path android:fillColor="#E2564B" android:pathData="M59,55 h5 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 h-5 a2,2 0 0 1 -2,-2 v-8 a2,2 0 0 1 2,-2 z" />
    <path android:fillColor="#35D0BA" android:pathData="M71,47 h5 a2,2 0 0 1 2,2 v16 a2,2 0 0 1 -2,2 h-5 a2,2 0 0 1 -2,-2 v-16 a2,2 0 0 1 2,-2 z" />
</vector>
